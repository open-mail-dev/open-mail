{%- comment -%}
  Signup popup + footer-newsletter signup, browse/cart tracking and a back-in-stock button for the mail system
  (mail-ingest). Install: upload as snippets/om-signup.liquid and add {% render 'om-signup' %} before </body> in
  layout/theme.liquid (ops/theme_signup.py does both). Texts per language live in the om-t / om-bis-t tables below.
  Popup: one card with a heading, a line of text and an email field (step 1), then "check your inbox" (step 2).
  Colours and corner radius are CSS custom properties (--om-*) at the top of the popup styles. The code is NEVER
  shown here: it only travels by email, so a typo'd or made-up address gets nothing (bounces burn the sending
  domain's reputation).
{%- endcomment -%}
{%- comment -%} Set this to your deployed mail-ingest URL (no trailing slash). {%- endcomment -%}
{%- assign om_api = 'https://REGION-PROJECT_ID.cloudfunctions.net/mail-ingest' -%}
{%- comment -%} One Shopify store can serve several domains (shop.example.com, shop-ie.example.com and shop-fi.example.com): the store key (stores.py) and the
  language come from the host. Any other host renders nothing; on the shop's primary domain the shop's own locale gets the
  primary storefront's key (shop.domain). A market in a subfolder of the primary domain (e.g. /de-de) can get its own key
  by storefront locale + country, e.g.:
    elsif om_host == shop.domain and request.locale.iso_code == 'de' and localization.country.iso_code == 'DE'
      and om_live contains 'shop.example.com/de-de' → om_store = 'shop.example.com/de-de', om_lang = 'de'
  (that key needs a Store with path_prefix='/de-de' in stores.py and a 'de' entry in both text tables). {%- endcomment -%}
{%- assign om_host = request.host | remove_first: 'www.' -%}
{%- comment -%} Market domains switch on one by one: one theme can serve all domains, and a market should only show this
  popup once any other signup popup there is switched off (else two codes, two series). Go-live = add the host here,
  then python ops/theme_signup.py <store> --apply. {%- endcomment -%}
{%- assign om_live = 'shop-ie.example.com,shop-fi.example.com' | split: ',' -%}
{%- comment -%} Browse/cart reminders (sitetrack.py) switch on per market the same way (plus MAIL_SITE_LIVE on the
  server). {%- endcomment -%}
{%- assign om_track = 'shop.example.com,shop-ie.example.com,shop-fi.example.com' | split: ',' -%}
{%- comment -%} Back-in-stock ("Notify me" on sold-out products, notify.py) switches on per market the same way (plus
  MAIL_BIS_LIVE on the server). {%- endcomment -%}
{%- assign om_bis = 'shop.example.com,shop-ie.example.com,shop-fi.example.com' | split: ',' -%}
{%- assign om_store = '' -%}
{%- if om_host == 'shop-ie.example.com' and om_live contains 'shop-ie.example.com' -%}{%- assign om_store = 'shop-ie.example.com' -%}{%- assign om_lang = 'en' -%}
{%- elsif om_host == 'shop-fi.example.com' and om_live contains 'shop-fi.example.com' -%}{%- assign om_store = 'shop-fi.example.com' -%}{%- assign om_lang = 'en' -%}
{%- elsif om_host == shop.domain and request.locale.iso_code == 'en' -%}{%- assign om_store = shop.domain -%}{%- assign om_lang = 'en' -%}
{%- endif -%}
{%- if om_store != blank -%}
{%- comment -%} A logged-in customer: sign "email|store" so mail-ingest/ident can hand this browser its visitor id. The key
  lives in shop metafield om.ident_key (= MAIL_IDENT_SECRET, set by ops/ident_key.py), never in this file;
  no key → no signature → nothing happens. {%- endcomment -%}
{%- assign om_ident_sig = '' -%}
{%- if customer and customer.email != blank and shop.metafields.om.ident_key.value != blank -%}
{%- assign om_ident_email = customer.email | strip | downcase -%}
{%- assign om_ident_sig = om_ident_email | append: '|' | append: om_store | hmac_sha256: shop.metafields.om.ident_key.value -%}
{%- endif -%}
<style>
  /* Theme it here: accent colour, corner radius, text colours. Fonts are inherited from the theme. */
  #om-signup { --om-accent: #2b59c3; --om-accent-text: #fff; --om-radius: 12px; --om-text: #1f2328; --om-muted: #5f6670; --om-border: #d0d5dd; --om-error: #b42318; --om-overlay: rgba(15, 23, 42, .28); }
  #om-signup { position: fixed; inset: 0; background: var(--om-overlay); z-index: 2147483000; align-items: center; justify-content: center; padding: 16px; font-family: inherit; }
  #om-signup .om-card { position: relative; background: #fff; width: 100%; max-width: 440px; border-radius: var(--om-radius); box-shadow: 0 12px 40px rgba(15, 23, 42, .18), 0 2px 6px rgba(15, 23, 42, .08); padding: 28px 24px 20px; box-sizing: border-box; color: var(--om-text); font-family: inherit; text-align: left; }
  #om-signup .om-x { position: absolute; top: 8px; right: 8px; width: 32px; height: 32px; border: 0; border-radius: 50%; background: transparent; color: var(--om-muted); font-size: 22px; line-height: 32px; text-align: center; cursor: pointer; padding: 0; }
  #om-signup .om-x:hover { background: rgba(0, 0, 0, .06); color: var(--om-text); }
  #om-signup .om-h { margin: 0 32px 8px 0; font-size: 22px; line-height: 1.3; font-weight: 600; color: var(--om-text); }
  #om-signup .om-p { margin: 0 0 16px; font-size: 15px; line-height: 1.5; color: var(--om-muted); }
  #om-signup .om-row { display: flex; flex-direction: row; gap: 8px; align-items: stretch; }
  #om-signup .om-in { flex: 1 1 auto; min-width: 0; height: 44px; box-sizing: border-box; border: 1px solid var(--om-border); border-radius: calc(var(--om-radius) / 2); padding: 0 12px; font: inherit; font-size: 16px; color: var(--om-text); background: #fff; margin: 0; }
  #om-signup .om-in:focus { outline: 2px solid var(--om-accent); outline-offset: 1px; border-color: var(--om-accent); }
  #om-signup .om-btn { flex: 0 0 auto; height: 44px; box-sizing: border-box; border: 0; border-radius: calc(var(--om-radius) / 2); background: var(--om-accent); color: var(--om-accent-text); font: inherit; font-size: 15px; font-weight: 600; padding: 0 18px; cursor: pointer; white-space: nowrap; }
  #om-signup .om-btn:hover { filter: brightness(1.08); }
  #om-signup .om-btn:focus-visible { outline: 2px solid var(--om-accent); outline-offset: 2px; }
  #om-signup .om-btn[disabled] { opacity: .6; cursor: default; }
  #om-signup .om-msg { margin: 8px 0 0; font-size: 14px; line-height: 1.4; min-height: 1em; color: var(--om-error); }
  #om-signup .om-msg:empty { display: none; }
  #om-signup .om-msg a { color: var(--om-text); text-decoration: underline; cursor: pointer; }
  #om-signup .om-fine { margin: 12px 0 0; font-size: 12px; line-height: 1.4; color: var(--om-muted); }
  #om-signup .om-no { display: inline-block; margin: 10px 0 0; padding: 4px 0; background: none; border: 0; font: inherit; font-size: 13px; color: var(--om-muted); text-decoration: underline; cursor: pointer; }
  #om-signup .om-done .om-btn { margin-top: 4px; }
  @media (max-width: 480px) {
    #om-signup .om-card { padding: 24px 18px 16px; }
    #om-signup .om-h { font-size: 20px; }
    #om-signup .om-row { flex-direction: column; }
    #om-signup .om-btn { width: 100%; }
  }
</style>
<div id="om-signup" hidden role="dialog" aria-modal="true" aria-labelledby="om-signup-title" aria-describedby="om-signup-text" style="display:none">
  <div class="om-card">
    <button type="button" class="om-x" id="om-signup-close" data-t-aria="close">&times;</button>
    <form data-step="1" id="om-signup-form" novalidate>
      <h2 class="om-h" id="om-signup-title" data-t="title"></h2>
      <p class="om-p" id="om-signup-text" data-t="text"></p>
      <div class="om-row">
        <input type="email" class="om-in" id="om-signup-email" name="email" required autocomplete="email" data-t-ph="placeholder" data-t-aria="placeholder">
        <button type="submit" class="om-btn" data-t="submit"></button>
      </div>
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">
      <p class="om-msg" id="om-signup-msg" role="status" aria-live="polite"></p>
      <p class="om-fine" data-t="fine"></p>
      <button type="button" class="om-no" id="om-no" data-t="no"></button>
    </form>
    <div data-step="2" class="om-done" hidden>
      <h2 class="om-h" data-t="done_title"></h2>
      <p class="om-p" id="om-done-text"></p>
      <button type="button" class="om-btn" id="om-done" data-t="done_btn"></button>
    </div>
  </div>
</div>
<script type="application/json" id="om-t">{
 "en": {
  "close": "Close",
  "title": "Get €10 off your first order",
  "text": "Sign up for our newsletter and we'll email you a €10 discount code.*",
  "placeholder": "Email address",
  "submit": "Sign up",
  "no": "No thanks",
  "fine": "*On orders of €100 or more, valid for 14 days, not combinable with other discounts. You can unsubscribe at any time.",
  "done_title": "Check your inbox",
  "done_btn": "Continue shopping",
  "err_check": "Please check your email address.",
  "typo": "Did you mean <a>{fix}</a>?",
  "err_many": "Too many attempts. Please try again later.",
  "err_undeliverable": "This email address doesn't seem to exist. Please check it.",
  "err_fail": "Something went wrong. Please try again later.",
  "done_new": "Your €10 code is on its way to <b>{addr}</b>. Nothing after a few minutes? Please also check your spam or promotions folder.",
  "done_repeat": "You're already signed up. We sent your €10 code to <b>{addr}</b> earlier. Can't find it? Please also check your spam or promotions folder.",
  "done_used": "You're already signed up with <b>{addr}</b>. The welcome discount can be used once per email address."
 }
}</script>
<script>
(function () {
  var T = JSON.parse(document.getElementById("om-t").textContent)[{{ om_lang | json }}];
  function fill(root) {
    var a = root.querySelectorAll("[data-t]"), i;
    for (i = 0; i < a.length; i++) a[i].innerHTML = T[a[i].getAttribute("data-t")];   // our own fixed texts
    a = root.querySelectorAll("[data-t-aria]"); for (i = 0; i < a.length; i++) a[i].setAttribute("aria-label", T[a[i].getAttribute("data-t-aria")]);
    a = root.querySelectorAll("[data-t-ph]"); for (i = 0; i < a.length; i++) a[i].setAttribute("placeholder", T[a[i].getAttribute("data-t-ph")]);
  }
  fill(document.getElementById("om-signup"));
  // Remember the last few products viewed in this browser (by id: a handle can be translated per domain) so the
  // welcome mail can show them.
  // Only once the visitor allowed marketing in Shopify's consent banner.
  var VIEWED = "om_viewed";
  {%- if template.name == "product" and product %}
  try {
    var cp = window.Shopify && window.Shopify.customerPrivacy;
    if (cp && typeof cp.marketingAllowed === "function" && cp.marketingAllowed()) {
      var h = String({{ product.id | json }}), v = JSON.parse(localStorage.getItem(VIEWED) || "[]").filter(function (x) { return x !== h; });
      v.unshift(h); localStorage.setItem(VIEWED, JSON.stringify(v.slice(0, 6)));
    }
  } catch (e) {}
  {%- endif %}
  function viewed() { try { var v = JSON.parse(localStorage.getItem(VIEWED) || "[]"); return Array.isArray(v) ? v.slice(0, 6) : []; } catch (e) { return []; } }
  var KEY = "om_signup_seen", DONE = "om_signed_up";
  var EP = {{ om_api | json }} + "/signup";   // mail-ingest/signup
  var el = document.getElementById("om-signup"), f = document.getElementById("om-signup-form"), msg = document.getElementById("om-signup-msg");
  var emailInput = document.getElementById("om-signup-email");
  var steps = el.querySelectorAll("[data-step]"), lastFocus = null, suggested = null, source = "popup";
  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function rm(k) { try { localStorage.removeItem(k); } catch (e) {} }
  function seen() { return Date.now() - (+get(KEY) || 0) < 14 * 864e5; }
  function show(n) { for (var i = 0; i < steps.length; i++) steps[i].hidden = steps[i].getAttribute("data-step") !== String(n); }
  function open(src) {
    source = src || "popup";
    lastFocus = document.activeElement;
    show(1);
    el.hidden = false;
    el.style.display = "flex";
    set(KEY, String(Date.now()));
    try { emailInput.focus(); } catch (e) {}
  }
  function close() {
    el.style.display = "none";
    el.hidden = true;
    if (lastFocus && typeof lastFocus.focus === "function") { try { lastFocus.focus(); } catch (e) {} }
    lastFocus = null;
  }
  // Common typos in the big mailbox domains → "Did you mean …?" (T.typo) (one gentle nudge, then we let it through).
  var FIX = { "gmial.com": "gmail.com", "gmal.com": "gmail.com", "gmai.com": "gmail.com", "gmail.co": "gmail.com",
    "gamil.com": "gmail.com", "gnail.com": "gmail.com", "hotmial.com": "hotmail.com", "hotmal.com": "hotmail.com", "hotmail.co": "hotmail.com",
    "hotmai.com": "hotmail.com", "outlok.com": "outlook.com", "outloo.com": "outlook.com",
    "outlook.co": "outlook.com", "yaho.com": "yahoo.com", "yahoo.co": "yahoo.com", "icloud.co": "icloud.com", "iclod.com": "icloud.com" };
  function typo(v) { var at = v.lastIndexOf("@"); if (at < 1) return null; var d = v.slice(at + 1).toLowerCase(); return FIX[d] ? v.slice(0, at + 1) + FIX[d] : null; }
  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }

  if (!get(DONE)) {
    if (!seen()) {
      setTimeout(function () { if (el.hidden) open(); }, 8000);
      addEventListener("scroll", function onS() { if (scrollY > document.body.scrollHeight / 2 - innerHeight) { removeEventListener("scroll", onS); if (el.hidden) open(); } }, { passive: true });
    }
  }
  document.getElementById("om-signup-close").onclick = close;
  document.getElementById("om-no").onclick = close;
  document.getElementById("om-done").onclick = close;
  el.addEventListener("click", function (e) { if (e.target === el) close(); });
  addEventListener("keydown", function (e) { if (e.key === "Escape" && !el.hidden) close(); });
  msg.addEventListener("click", function (e) { if (e.target.tagName === "A" && suggested) { emailInput.value = suggested; msg.textContent = ""; suggested = null; emailInput.focus(); } });
  // The theme's footer newsletter form (Shopify contact form tagged "newsletter") signs up through us too, so it gets
  // the same welcome mails and the same address checks: the email moves into the popup's form and is submitted
  // there. Without JS the Shopify form still posts as before.
  var footers = document.querySelectorAll('form[action^="/contact"]');
  for (var i = 0; i < footers.length; i++) (function (ff) {
    var tags = ff.querySelector('input[name="contact[tags]"]'), em = ff.querySelector('input[type="email"], input[name="contact[email]"]');
    if (!tags || !em || tags.value.indexOf("newsletter") < 0) return;
    ff.addEventListener("submit", function (e) {
      e.preventDefault();
      open("footer");
      emailInput.value = em.value.trim(); msg.textContent = ""; suggested = null;
      if (f.requestSubmit) f.requestSubmit(); else f.dispatchEvent(new Event("submit", { cancelable: true }));
    });
  })(footers[i]);
  f.addEventListener("submit", function (e) {
    e.preventDefault();
    var addr = emailInput.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(addr)) { msg.textContent = T.err_check; return; }
    var fix = typo(addr);
    if (fix && fix !== suggested) { suggested = fix; msg.innerHTML = T.typo.replace("{fix}", esc(fix)); return; }
    var btn = f.querySelector("button[type=submit]"); btn.disabled = true; msg.textContent = "";
    fetch(EP, { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ store: {{ om_store | json }}, email: addr, source: source, website: f.website.value, viewed: viewed() }) })
      .then(function (r) { return r.json().then(function (b) { return { s: r.status, b: b }; }); })
      .then(function (x) {
        btn.disabled = false;
        if (x.s === 200) {
          set(DONE, "1");
          if (x.b.vid) { pendingId = x.b.vid; track(); }
          var t = document.getElementById("om-done-text");
          if (x.b.repeat && !x.b.code_valid) { t.innerHTML = T.done_used.replace("{addr}", esc(addr)); }
          else if (x.b.repeat) { t.innerHTML = T.done_repeat.replace("{addr}", esc(addr)); }
          else { t.innerHTML = T.done_new.replace("{addr}", esc(addr)); }
          show(2);
          try { document.getElementById("om-done").focus(); } catch (e) {}
        }
        else if (x.s === 429) { msg.textContent = T.err_many; }
        else if (x.s === 400 && x.b.error === "undeliverable") { msg.textContent = T.err_undeliverable; }
        else if (x.s === 400) { msg.textContent = T.err_check; }
        else { msg.textContent = T.err_fail; }
      })
      .catch(function () { btn.disabled = false; msg.textContent = T.err_fail; });
  });
  // Browse/cart reminders: know this browser (signup, #om= after a click in one of our mails, or a customer login) and
  // report product views + cart adds. Nothing — not even the id — is stored before the visitor allowed marketing in Shopify's consent
  // banner. The id is kept on every market; events are only sent on markets listed in om_track.
  var ID = "om_id", CART_SEEN = "om_cart_seen", CUST = "om_cust", pendingId = null;
  var TRACK = {{ om_api | json }} + "/track";   // mail-ingest/track
  var IDENT = {{ om_api | json }} + "/ident";   // mail-ingest/ident
  var hm = /(?:^#|&)om=([A-Za-z0-9_.-]+)/.exec(location.hash);
  if (hm) {
    pendingId = hm[1];
    try { history.replaceState(null, "", location.pathname + location.search); } catch (e) {}
  }
  function mktOk() {
    var cp = window.Shopify && window.Shopify.customerPrivacy;
    return !!(cp && typeof cp.marketingAllowed === "function" && cp.marketingAllowed());
  }
  function post(b) {
    try {
      // text/plain = a simple CORS request (no preflight), which a keepalive fetch on page hide needs
      fetch(TRACK, { method: "POST", headers: { "Content-Type": "text/plain;charset=UTF-8" }, keepalive: true, body: JSON.stringify(b) })
        .catch(function () {});
    } catch (e) {}
  }
  function cartCheck(vid) {
    {%- if om_track contains om_store -%}
    fetch("/cart.js", { credentials: "same-origin" }).then(function (r) { return r.json(); }).then(function (c) {
      var seen, now = [];
      try { seen = JSON.parse(get(CART_SEEN) || "[]"); } catch (e) { seen = []; }
      (c.items || []).forEach(function (it) {
        var v = String(it.variant_id);
        now.push(v);
        if (seen.indexOf(v) < 0) post({ store: {{ om_store | json }}, vid: vid, type: "added_to_cart", product_id: String(it.product_id), variant_id: v });
      });
      set(CART_SEEN, JSON.stringify(now.slice(0, 50)));
    }).catch(function () {});
    {%- endif -%}
  }
  function ident() {
    {%- if om_track contains om_store and om_ident_sig != blank %}
    // a logged-in customer wins over any id kept here (shared PC); asked once per customer per browser
    if (ident.busy || get(CUST) === String({{ customer.id | json }})) return false;
    ident.busy = true;
    fetch(IDENT, { method: "POST", headers: { "Content-Type": "text/plain;charset=UTF-8" },
      body: JSON.stringify({ store: {{ om_store | json }}, email: {{ om_ident_email | json }}, sig: {{ om_ident_sig | json }} }) })
      .then(function (r) { return r.json(); })
      .then(function (b) {
        if ("vid" in b) { if (b.vid) set(ID, b.vid); else rm(ID); set(CUST, String({{ customer.id | json }})); }
        ident.busy = false; track();
      })
      .catch(function () { ident.busy = false; });
    return true;
    {%- else %}
    return false;
    {%- endif %}
  }
  function track() {
    if (!mktOk()) return;
    if (pendingId) { set(ID, pendingId); pendingId = null; }
    if (ident()) return;                    // reports this page once the answer is in
    var vid = get(ID);
    if (!vid) return;
    {%- if om_track contains om_store -%}
    {%- if template.name == "product" and product %}
    if (!track.viewed) { track.viewed = true; post({ store: {{ om_store | json }}, vid: vid, type: "viewed_product", product_id: String({{ product.id | json }}) }); }
    {%- endif %}
    cartCheck(vid);
    {%- endif -%}
  }
  addEventListener("load", function () { track(); setTimeout(track, 3000); });   // customerPrivacy may load late
  document.addEventListener("visitorConsentCollected", track);
  document.addEventListener("visibilitychange", function () { if (document.visibilityState === "hidden" && mktOk() && get(ID)) cartCheck(get(ID)); });
})();
</script>
{%- if template.name == "product" and product and om_bis contains om_store and product.type != 'never available again' %}
{%- comment -%} Back-in-stock: a "Notify me" button below the add-to-cart form. Shown
  only while the selected variant is sold out; a request is for that variant. Not marketing: no consent, no code. {%- endcomment -%}
<style>
  #om-bis { margin: 12px 0 0; }
  #om-bis [hidden] { display: none !important; }
  #om-bis .om-bis-btn { width: 100%; min-height: 48px; background: #fff; color: #1a1a1a; border: 1px solid #1a1a1a; border-radius: 0; cursor: pointer; }
  #om-bis form { margin-top: 10px; display: flex; flex-direction: row; align-items: stretch; gap: 8px; flex-wrap: wrap; }
  #om-bis input[type=email] { flex: 1 1 200px; height: 44px; min-height: 0; box-sizing: border-box; padding: 0 12px; border: 1px solid #1a1a1a; border-radius: 0; font: inherit; }
  #om-bis .om-bis-submit { flex: 0 0 auto; height: 44px; padding: 0 18px; background: #1a1a1a; color: #fff; border: 1px solid #1a1a1a; border-radius: 0; cursor: pointer; }
  #om-bis .om-bis-hp { position: absolute; left: -9999px; }
  #om-bis .om-bis-msg { margin: 8px 0 0; font-size: 14px; color: #1a1a1a; }
</style>
<div id="om-bis" hidden>
  <button type="button" class="btn om-bis-btn"></button>
  <div class="om-bis-panel" hidden>
    <p class="om-bis-msg om-bis-intro"></p>
    <form novalidate>
      <input type="email" name="email" autocomplete="email" required value="{%- if customer -%}{{ customer.email | escape }}{%- endif -%}">
      <input type="text" name="website" class="om-bis-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button type="submit" class="btn om-bis-submit"></button>
    </form>
    <p class="om-bis-msg om-bis-result" role="status"></p>
  </div>
</div>
{%- comment -%} Texts per language (add one entry per om_lang you use). {%- endcomment -%}
<script type="application/json" id="om-bis-t">{
 "en": {
  "btn": "Notify me when available",
  "intro": "{title} is out of stock right now. Leave your email address and we'll let you know as soon as it's back.",
  "email": "Email address",
  "submit": "Notify me",
  "ok": "Done! We'll email you as soon as {title} is back in stock.",
  "back": "This product is available again – please refresh the page.",
  "bad": "Please check your email address.",
  "fail": "Something went wrong, please try again later."
 }
}</script>
<script>
(function () {
  var NOTIFY = {{ om_api | json }} + "/notify";   // mail-ingest/notify
  var PRODUCT_ID = String({{ product.id | json }}), TITLE = {{ product.title | json }};
  var VARIANTS = {{ product.variants | json }}.map(function (v) { return [String(v.id), v.available]; });
  var box = document.getElementById("om-bis"), btn = box.querySelector(".om-bis-btn"), panel = box.querySelector(".om-bis-panel");
  var form = box.querySelector("form"), intro = box.querySelector(".om-bis-intro"), result = box.querySelector(".om-bis-result");
  var hasCustomer = {{ customer.email | default: '' | json }} !== "";
  var T = JSON.parse(document.getElementById("om-bis-t").textContent)[{{ om_lang | json }}];
  btn.textContent = T.btn; box.querySelector(".om-bis-submit").textContent = T.submit;
  form.email.placeholder = T.email; form.email.setAttribute("aria-label", T.email);
  intro.textContent = T.intro.replace("{title}", TITLE);
  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function addForm() { return document.querySelector('form[action*="/cart/add"]'); }
  function selected() {
    var f = addForm(), el = f && f.querySelector('[name="id"]');
    var id = (el && el.value) || new URLSearchParams(location.search).get("variant") || {{ product.selected_or_first_available_variant.id | json }};
    return String(id);
  }
  function soldOut(id) { for (var i = 0; i < VARIANTS.length; i++) if (VARIANTS[i][0] === id) return !VARIANTS[i][1]; return false; }
  function place() {
    var f = addForm();
    if (f && box.parentNode !== f.parentNode) f.parentNode.insertBefore(box, f.nextSibling);
  }
  function update() { place(); box.hidden = !soldOut(selected()); }
  btn.addEventListener("click", function () {
    // known browser (a click in one of our mails, or a signup), not logged in: one click, no typing
    var vid = get("om_id");
    if (vid && !hasCustomer) { send({ vid: vid }); return; }
    panel.hidden = false; btn.hidden = true; form.querySelector("[name=email]").focus();
  });
  form.addEventListener("submit", function (e) { e.preventDefault(); send({ email: form.email.value }); });
  function send(who) {
    var b = { store: {{ om_store | json }}, product_id: PRODUCT_ID, variant_id: selected(), website: form.website.value };
    for (var k in who) b[k] = who[k];
    panel.hidden = false; btn.hidden = true; result.textContent = "";
    fetch(NOTIFY, { method: "POST", headers: { "Content-Type": "text/plain;charset=UTF-8" }, body: JSON.stringify(b) })
      .then(function (r) {
        if (r.status === 200) { form.hidden = true; intro.hidden = true; result.textContent = T.ok.replace("{title}", TITLE); }
        else if (r.status === 409) result.textContent = T.back;
        else if (r.status === 400 && who.email !== undefined) result.textContent = T.bad;
        else result.textContent = T.fail;
      })
      .catch(function () { result.textContent = T.fail; });
  }
  document.addEventListener("change", function () { setTimeout(update, 50); });
  document.addEventListener("click", function () { setTimeout(update, 50); });
  addEventListener("popstate", update);
  update();
})();
</script>
{%- endif %}
{%- endif -%}
