# Copy to .env for local runs; on Cloud Functions set these as env vars / Secret Manager secrets (see deploy.sh).
# Never commit real values.

# --- secrets ---
MAIL_DB_DSN=postgresql://mail:CHANGE_ME@127.0.0.1:5432/mail
MAIL_TOKEN_SECRET=CHANGE_ME_random_32_bytes        # signs click / open / unsubscribe / visitor tokens
MAIL_IDENT_SECRET=CHANGE_ME_random_32_bytes        # = shop metafield lsp.ident_key (ops/ident_key.py)
AWS_ACCESS_KEY_ID=CHANGE_ME                        # IAM user allowed ses:SendEmail only
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# One Shopify app per Shopify store; names come from stores.py (client_id_env / client_secret_env).
SHOPIFY_CLIENT_ID_EXAMPLE_SHOP=CHANGE_ME
SHOPIFY_CLIENT_SECRET_EXAMPLE_SHOP=CHANGE_ME       # also verifies that store's webhooks
SHOPIFY_CLIENT_ID_EXAMPLE_OUTLET=CHANGE_ME
SHOPIFY_CLIENT_SECRET_EXAMPLE_OUTLET=CHANGE_ME
SLACK_WEBHOOK_URL=                                 # optional: alerts; empty = log only

# --- settings ---
MAIL_WEB_BASE_URL=https://REGION-PROJECT_ID.cloudfunctions.net/mail-web
MAIL_SES_REGION=eu-west-1
MAIL_SNS_TOPIC_ARNS=arn:aws:sns:eu-west-1:000000000000:mail-ses-events   # comma-separated; empty rejects all SNS messages
MAIL_TIMEZONE=Europe/Amsterdam                     # shop time zone for code expiry dates

# --- per-flow switches (comma-separated store keys; read on every request, so they work as kill switches) ---
MAIL_AC_SINCE=                                     # ISO 8601 UTC go-live for abandoned-checkout reminders; empty = off
MAIL_AC_SINCE_BY_STORE=                            # JSON, e.g. {"shop-ie.example.com": "2026-10-13T09:00:00Z"} (Store.ac_own_start)
MAIL_SITE_LIVE=                                    # browse abandonment + cart reminder (mail-ingest and mail-tick)
MAIL_PP_LIVE=                                      # post-purchase (mail-ingest and mail-tick)
MAIL_WB_LIVE=                                      # win-back (mail-tick)
MAIL_BIS_LIVE=                                     # back-in-stock (mail-ingest and mail-tick)

# --- one-off migration only ---
KLAVIYO_KEY=                                       # import_klaviyo.py
